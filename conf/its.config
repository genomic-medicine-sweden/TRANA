/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running ITS analysis
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines params and settings for running ITS analysis.

    Use as follows:
        nextflow run genomic-medicine-sweden/TRANA -profile its,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'ITS profile'
    config_profile_description = 'Recommended configuration for ITS analysis'

    // filtlong filtering
    quality_filtering                   = true
    longread_qc_qualityfilter_minlength = 300
    longread_qc_qualityfilter_maxlength = 900

    // krona
    its = true

}